# Contact form delivery (Resend)
# Get a key at https://resend.com/api-keys — required for the form to send.
RESEND_API_KEY=

# Where submissions are delivered. Defaults to prathamwankhade2004@gmail.com
CONTACT_TO_EMAIL=

# Verified sender. Until a domain is verified in Resend, keep the
# onboarding sender; Resend only allows it to mail the account owner.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
